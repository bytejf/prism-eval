diff --git a/evaluation/evaluate.py b/evaluation/evaluate.py
index 373fa1c..722a978 100644
--- a/evaluation/evaluate.py
+++ b/evaluation/evaluate.py
@@ -181,6 +181,38 @@ def build_target_comments_from_ocr(result: Dict[str, Any]) -> List[Dict[str, Any
     return comments
 
 
+def build_target_comments_from_prism(result: Dict[str, Any]) -> List[Dict[str, Any]]:
+    """prism 结果 -> 待评测评论。
+
+    从 `prism.comments`（原始 JSON）读，而不是从 `review.comments`（OCR 兼容形状）：
+    后者为了对齐 harness 丢掉了精度 —— 尤其是 `side`，prism 会报左侧（删除行）的
+    评论，**不能硬编码成 right**（那会让所有左侧评论在第二阶段被当成不匹配）。
+    另外 `locate_level` 也只在原始 JSON 里，分析「未定位评论的命中率」要用。
+    """
+    review = result.get("prism") or {}
+    comments = []
+    for finding in review.get("comments", []) or []:
+        if not isinstance(finding, dict):
+            continue
+        note = (finding.get("content") or "").strip()
+        if not note:
+            continue
+        line_range = _normalize_line_range(finding.get("start_line"), finding.get("end_line"))
+        side = str(finding.get("side") or "").lower()
+        comments.append(
+            {
+                "note": note,
+                "path": finding.get("path", ""),
+                # 未定位的评论没有 side（prism 那边是 None）—— 保持 None，
+                # 让匹配跳过第二阶段而不是猜一个
+                "side": side or None,
+                "from_line": line_range["from_line"],
+                "to_line": line_range["to_line"],
+            }
+        )
+    return comments
+
+
 def load_target_comments(
     results_dir: Path, reviewer: str, instance_id: str
 ) -> Optional[List[Dict[str, Any]]]:
@@ -200,6 +232,7 @@ def load_target_comments(
     builder = {
         "claude": build_target_comments_from_claude,
         "codex": build_target_comments_from_codex,  # 独立实现，非别名
+        "prism": build_target_comments_from_prism,
     }.get(reviewer, build_target_comments_from_ocr)
     return builder(result)
 
